{
  "name": "nambv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint eslint.config.mjs middleware.ts prisma/seed.ts 'src/app/[locale]' src/app/admin src/app/admin-v2 src/app/api/public src/app/api/admin src/app/api/v2 src/components/v2 src/lib/v2 tests/smoke src/lib/auth.ts src/lib/legacy-session.ts",
    "lint:repo": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:smoke": "playwright test",
    "test:smoke:prod": "PLAYWRIGHT_BASE_URL=https://nambv.vercel.app playwright test",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:v2": "tsx scripts/bootstrap-v2-foundation.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.97.0",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.469.0",
    "next": "^16.1.1",
    "next-intl": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
