# Database
# Runtime on Vercel/serverless: Supabase transaction pooler (6543) with PgBouncer flags
DATABASE_URL="postgresql://user:password@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations / db push: pooled direct/session connection
DIRECT_URL="postgresql://user:password@aws-1-eu-west-3.pooler.supabase.com:5432/postgres"

# Supabase storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Optional for future server-side uploads
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Analytics
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Email & notifications
RESEND_API_KEY="re_xxx"
FROM_EMAIL="Nam Construction <noreply@namconstruction.be>"
ADMIN_EMAIL="info@namconstruction.be"
TWILIO_ACCOUNT_SID="ACxxxx"
TWILIO_AUTH_TOKEN="xxxx"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Legacy admin
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="replace-with-long-random-secret"

# v2 single-admin bootstrap
V2_ADMIN_EMAIL="admin@namconstruction.be"
V2_ADMIN_PASSWORD="replace-with-a-strong-unique-password"
