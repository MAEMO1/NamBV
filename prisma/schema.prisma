// Nam Construction - Prisma Schema
// Database: PostgreSQL (recommended) or MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  SUPERADMIN
  ADMIN
}

enum QuoteStatus {
  NEW
  CONTACTED
  SITE_VISIT
  QUOTE_SENT
  NEGOTIATING
  WON
  LOST
  CANCELLED
}

enum BudgetRange {
  UNDER_10K
  RANGE_10K_25K
  RANGE_25K_50K
  RANGE_50K_100K
  OVER_100K
  UNKNOWN
}

// ============================================================================
// USERS - Admin accounts
// ============================================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         UserRole  @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLogin    DateTime? @map("last_login")

  // Relations
  assignedQuotes  QuoteRequest[]       @relation("AssignedQuotes")
  createdServices ServiceType[]        @relation("CreatedServices")
  notes           QuoteNote[]
  statusChanges   QuoteStatusHistory[] @relation("ChangedBy")

  @@map("users")
}

// ============================================================================
// SERVICE TYPES - Renovation categories (rubrieken)
// ============================================================================

model ServiceType {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  createdBy   User?                    @relation("CreatedServices", fields: [createdById], references: [id])
  createdById String?                  @map("created_by")
  quotes      QuoteServiceSelection[]

  @@index([isActive, sortOrder])
  @@map("service_types")
}

// ============================================================================
// PROPERTY TYPES - Housing types
// ============================================================================

model PropertyType {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  quotes QuoteRequest[]

  @@map("property_types")
}

// ============================================================================
// QUOTE REQUESTS - Main entity for quote submissions
// ============================================================================

model QuoteRequest {
  id              String       @id @default(cuid())
  referenceNumber String       @unique @map("reference_number")
  status          QuoteStatus  @default(NEW)

  // Contact info
  fullName        String       @map("full_name")
  email           String
  phone           String
  postalCode      String       @map("postal_code")
  city            String?
  streetAddress   String?      @map("street_address")

  // Project details
  description     String       @db.Text
  preferredStart  String?      @map("preferred_start")
  budgetRange     BudgetRange? @map("budget_range")
  gdprConsent     Boolean      @default(false) @map("gdpr_consent")

  // Timestamps
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  convertedAt     DateTime?    @map("converted_at")

  // Soft delete
  deletedAt       DateTime?    @map("deleted_at")

  // Relations
  propertyType    PropertyType?           @relation(fields: [propertyTypeId], references: [id])
  propertyTypeId  String?                 @map("property_type_id")
  assignedTo      User?                   @relation("AssignedQuotes", fields: [assignedToId], references: [id])
  assignedToId    String?                 @map("assigned_to")
  services        QuoteServiceSelection[]
  photos          QuotePhoto[]
  notes           QuoteNote[]
  statusHistory   QuoteStatusHistory[]

  // Indexes for common queries
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([postalCode])
  @@index([assignedToId])
  @@index([deletedAt])
  @@map("quote_requests")
}

// ============================================================================
// QUOTE SERVICE SELECTIONS - Many-to-many relation
// ============================================================================

model QuoteServiceSelection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  quote         QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId       String       @map("quote_id")
  serviceType   ServiceType  @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  serviceTypeId String       @map("service_type_id")

  @@unique([quoteId, serviceTypeId])
  @@map("quote_service_selections")
}

// ============================================================================
// QUOTE PHOTOS - Uploaded images
// ============================================================================

model QuotePhoto {
  id         String   @id @default(cuid())
  filePath   String   @map("file_path")
  fileName   String   @map("file_name")
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  // Relations
  quote   QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String       @map("quote_id")

  @@index([quoteId])
  @@map("quote_photos")
}

// ============================================================================
// QUOTE NOTES - Internal admin notes
// ============================================================================

model QuoteNote {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  quote   QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String       @map("quote_id")
  user    User         @relation(fields: [userId], references: [id])
  userId  String       @map("user_id")

  @@index([quoteId, createdAt(sort: Desc)])
  @@map("quote_notes")
}

// ============================================================================
// QUOTE STATUS HISTORY - Audit trail for status changes
// ============================================================================

model QuoteStatusHistory {
  id         String       @id @default(cuid())
  fromStatus QuoteStatus? @map("from_status")
  toStatus   QuoteStatus  @map("to_status")
  reason     String?      @db.Text
  changedAt  DateTime     @default(now()) @map("changed_at")

  // Relations
  quote       QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     String       @map("quote_id")
  changedBy   User         @relation("ChangedBy", fields: [changedById], references: [id])
  changedById String       @map("changed_by")

  @@index([quoteId, changedAt(sort: Desc)])
  @@map("quote_status_history")
}

// ============================================================================
// APPOINTMENT AVAILABILITY - Configurable time slots
// ============================================================================

model AppointmentAvailability {
  id          String   @id @default(cuid())

  // Day of week (0 = Sunday, 1 = Monday, etc.)
  dayOfWeek   Int      @map("day_of_week")

  // Time slots for this day (e.g., ["09:00", "10:00", "14:00"])
  timeSlots   String[] @map("time_slots")

  // Whether this day is active
  isActive    Boolean  @default(true) @map("is_active")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([dayOfWeek])
  @@map("appointment_availability")
}

model AppointmentBlockedDate {
  id          String   @id @default(cuid())

  // The blocked date
  date        DateTime @db.Date

  // Optional: specific times blocked (if empty, whole day is blocked)
  blockedTimes String[] @default([]) @map("blocked_times")

  // Reason for blocking (e.g., "Vakantie", "Feestdag")
  reason      String?

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([date])
  @@index([date])
  @@map("appointment_blocked_dates")
}

// ============================================================================
// APPOINTMENTS - Adviesgesprek bookings
// ============================================================================

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

model Appointment {
  id              String            @id @default(cuid())
  referenceNumber String            @unique @map("reference_number")
  status          AppointmentStatus @default(PENDING)

  // Contact info
  fullName        String            @map("full_name")
  email           String
  phone           String
  gemeente        String

  // Appointment details
  appointmentDate DateTime          @map("appointment_date")
  appointmentTime String            @map("appointment_time")

  // Proposed alternative (when admin suggests different time)
  proposedDate    DateTime?         @map("proposed_date")
  proposedTime    String?           @map("proposed_time")

  // Admin notes
  adminNotes      String?           @map("admin_notes") @db.Text
  rejectionReason String?           @map("rejection_reason")

  // Project preferences
  projectType       String?         @map("project_type")
  propertyType      String?         @map("property_type")
  propertyAge       String?         @map("property_age")
  priorities        String[]        @default([])
  materialPreference String?        @map("material_preference")
  budget            String?
  timing            String?
  subsidyInterest   Boolean         @default(false) @map("subsidy_interest")
  paymentSpread     Boolean         @default(false) @map("payment_spread")
  motivation        String?
  message           String?         @db.Text

  // Timestamps
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  confirmedAt     DateTime?         @map("confirmed_at")

  @@index([status])
  @@index([appointmentDate])
  @@index([createdAt(sort: Desc)])
  @@map("appointments")
}

// ============================================================================
// ANALYTICS - Privacy-friendly website analytics
// ============================================================================

model PageView {
  id          String   @id @default(cuid())

  // Page info
  path        String
  referrer    String?

  // Visitor info (no cookies, fingerprint-based)
  visitorId   String   @map("visitor_id")
  sessionId   String   @map("session_id")

  // Device & location
  userAgent   String?  @map("user_agent")
  deviceType  String?  @map("device_type") // desktop, mobile, tablet
  browser     String?
  os          String?
  country     String?
  city        String?

  // UTM parameters
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([path])
  @@index([visitorId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([createdAt, path])
  @@map("page_views")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())

  // Event info
  eventType   String   @map("event_type") // click, form_submit, scroll, etc.
  eventName   String   @map("event_name") // cta_click, quote_submit, etc.
  eventData   Json?    @map("event_data")

  // Page context
  path        String

  // Visitor info
  visitorId   String   @map("visitor_id")
  sessionId   String   @map("session_id")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([eventType, eventName])
  @@index([visitorId])
  @@index([createdAt])
  @@map("analytics_events")
}

model DailyStats {
  id              String   @id @default(cuid())
  date            DateTime @unique @db.Date

  // Traffic stats
  pageViews       Int      @default(0) @map("page_views")
  uniqueVisitors  Int      @default(0) @map("unique_visitors")
  sessions        Int      @default(0)

  // Engagement
  avgSessionDuration Int   @default(0) @map("avg_session_duration") // in seconds
  bounceRate      Float    @default(0) @map("bounce_rate")

  // Conversions
  quoteRequests   Int      @default(0) @map("quote_requests")
  appointments    Int      @default(0)

  // Device breakdown
  desktopVisits   Int      @default(0) @map("desktop_visits")
  mobileVisits    Int      @default(0) @map("mobile_visits")
  tabletVisits    Int      @default(0) @map("tablet_visits")

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("daily_stats")
}

// ============================================================================
// PROJECTS - Portfolio projects
// ============================================================================

model Project {
  id            String   @id @default(cuid())

  // Basic info
  title         String
  slug          String   @unique
  description   String?  @db.Text
  shortDescription String? @map("short_description")

  // Categorization
  category      String   // Totaalrenovatie, Renovatie, Afwerking, etc.
  location      String
  year          Int

  // Project detail content (De Raedt style)
  challengeText   String?  @map("challenge_text") @db.Text
  approachText    String?  @map("approach_text") @db.Text
  resultText      String?  @map("result_text") @db.Text

  // Project metadata
  projectType     String?  @map("project_type")
  duration        String?
  surface         String?
  completionDate  String?  @map("completion_date")

  // Display
  featured      Boolean  @default(false)
  sortOrder     Int      @default(0) @map("sort_order")
  isPublished   Boolean  @default(true) @map("is_published")

  // Images
  mainImage     String?  @map("main_image")

  // Timestamps
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  images        ProjectImage[]

  @@index([isPublished, sortOrder])
  @@index([featured])
  @@index([category])
  @@map("projects")
}

model ProjectImage {
  id          String   @id @default(cuid())

  // Image info
  url         String
  alt         String?
  caption     String?
  sortOrder   Int      @default(0) @map("sort_order")
  isBefore    Boolean  @default(false) @map("is_before") // for before/after
  isAfter     Boolean  @default(false) @map("is_after")

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String   @map("project_id")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([projectId, sortOrder])
  @@map("project_images")
}

// ============================================================================
// SETTINGS - Site configuration
// ============================================================================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  type        String   @default("string") // string, number, boolean, json
  category    String   @default("general") // general, contact, seo, notifications
  description String?

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("settings")
}

// ============================================================================
// CONTENT - Editable content blocks
// ============================================================================

model ContentBlock {
  id          String   @id @default(cuid())

  // Identification
  page        String   // home, about, services, etc.
  section     String   // hero, features, cta, etc.
  key         String   // title, subtitle, description, etc.

  // Content
  content     String   @db.Text
  type        String   @default("text") // text, html, markdown, image

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([page, section, key])
  @@index([page])
  @@map("content_blocks")
}

// ============================================================================
// MEDIA - Media library
// ============================================================================

model MediaFile {
  id          String   @id @default(cuid())

  // File info
  filename    String
  originalName String  @map("original_name")
  mimeType    String   @map("mime_type")
  size        Int      // in bytes
  url         String

  // Image specific
  width       Int?
  height      Int?
  alt         String?

  // Organization
  folder      String   @default("/")
  tags        String[] @default([])

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([folder])
  @@index([mimeType])
  @@index([createdAt])
  @@map("media_files")
}

// ============================================================================
// V2 - PARALLEL REBUILD FOUNDATION
// ============================================================================

model V2AdminUser {
  id            String           @id @default(cuid())
  email         String           @unique
  passwordHash  String           @map("password_hash")
  fullName      String           @map("full_name")
  isActive      Boolean          @default(true) @map("is_active")
  lastLoginAt   DateTime?        @map("last_login_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  sessions      V2AdminSession[]
  auditEvents   V2AuditEvent[]

  @@map("v2_admin_users")
}

model V2AdminSession {
  id            String       @id @default(cuid())
  tokenHash     String       @unique @map("token_hash")
  expiresAt     DateTime     @map("expires_at")
  lastSeenAt    DateTime     @default(now()) @map("last_seen_at")
  invalidatedAt DateTime?    @map("invalidated_at")
  ipAddress     String?      @map("ip_address")
  userAgent     String?      @map("user_agent")
  createdAt     DateTime     @default(now()) @map("created_at")

  user          V2AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String       @map("user_id")

  @@index([userId])
  @@index([expiresAt])
  @@index([invalidatedAt])
  @@map("v2_admin_sessions")
}

model V2LoginAttempt {
  id            String    @id @default(cuid())
  email         String
  ipAddress     String?   @map("ip_address")
  wasSuccessful Boolean   @default(false) @map("was_successful")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt(sort: Desc)])
  @@index([ipAddress, createdAt(sort: Desc)])
  @@map("v2_login_attempts")
}

model V2SubmissionAttempt {
  id          String    @id @default(cuid())
  kind        String
  email       String?
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  wasAccepted Boolean   @default(false) @map("was_accepted")
  reason      String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([kind, createdAt(sort: Desc)])
  @@index([kind, email, createdAt(sort: Desc)])
  @@index([kind, ipAddress, createdAt(sort: Desc)])
  @@map("v2_submission_attempts")
}

model V2SequenceCounter {
  key       String    @id
  value     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("v2_sequence_counters")
}

model V2QuoteRequest {
  id              String       @id @default(cuid())
  referenceNumber String       @unique @map("reference_number")
  status          QuoteStatus  @default(NEW)
  fullName        String       @map("full_name")
  email           String
  phone           String
  postalCode      String       @map("postal_code")
  city            String?
  description     String       @db.Text
  preferredStart  String?      @map("preferred_start")
  budgetRange     BudgetRange? @map("budget_range")
  gdprConsent     Boolean      @default(false) @map("gdpr_consent")
  adminNotes      String?      @map("admin_notes") @db.Text
  propertyTypeId  String?      @map("property_type_id")
  serviceTypeIds  String[]     @default([]) @map("service_type_ids")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  leadEvents      V2LeadEvent[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("v2_quote_requests")
}

model V2Appointment {
  id                 String             @id @default(cuid())
  referenceNumber    String             @unique @map("reference_number")
  activeSlotKey      String?            @unique @map("active_slot_key")
  status             AppointmentStatus  @default(PENDING)
  fullName           String             @map("full_name")
  email              String
  phone              String
  municipality       String             @map("municipality")
  appointmentDate    DateTime           @db.Date @map("appointment_date")
  appointmentTime    String             @map("appointment_time")
  projectType        String?            @map("project_type")
  propertyType       String?            @map("property_type")
  propertyAge        String?            @map("property_age")
  priorities         String[]           @default([])
  materialPreference String?            @map("material_preference")
  budget             String?
  timing             String?
  subsidyInterest    Boolean            @default(false) @map("subsidy_interest")
  paymentSpread      Boolean            @default(false) @map("payment_spread")
  motivation         String?
  message            String?            @db.Text
  adminNotes         String?            @map("admin_notes") @db.Text
  proposedDate       DateTime?          @db.Date @map("proposed_date")
  proposedTime       String?            @map("proposed_time")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  confirmedAt        DateTime?          @map("confirmed_at")

  leadEvents         V2LeadEvent[]

  @@index([status])
  @@index([appointmentDate])
  @@index([createdAt(sort: Desc)])
  @@map("v2_appointments")
}

model V2AvailabilityRule {
  id          String    @id @default(cuid())
  dayOfWeek   Int       @unique @map("day_of_week")
  timeSlots   String[]  @default([]) @map("time_slots")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("v2_availability_rules")
}

model V2AvailabilityException {
  id          String    @id @default(cuid())
  date        DateTime  @db.Date
  blockedTimes String[] @default([]) @map("blocked_times")
  reason      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([date])
  @@index([date])
  @@map("v2_availability_exceptions")
}

model V2PageSection {
  id           String    @id @default(cuid())
  pageKey      String    @map("page_key")
  sectionKey   String    @map("section_key")
  locale       String
  schemaKey    String    @map("schema_key")
  dataJson     Json      @map("data_json")
  displayOrder Int       @default(0) @map("display_order")
  published    Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([pageKey, sectionKey, locale, displayOrder])
  @@index([pageKey, locale])
  @@map("v2_page_sections")
}

model V2Project {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  category        String
  location        String
  year            Int
  featured        Boolean                @default(false)
  isPublished     Boolean                @default(true) @map("is_published")
  sortOrder       Int                    @default(0) @map("sort_order")
  coverImageUrl   String?                @map("cover_image_url")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  translations    V2ProjectTranslation[]
  images          V2ProjectImage[]

  @@index([isPublished, sortOrder])
  @@index([featured])
  @@map("v2_projects")
}

model V2ProjectTranslation {
  id               String    @id @default(cuid())
  locale           String
  title            String
  shortDescription String?   @map("short_description")
  description      String?   @db.Text
  challengeText    String?   @map("challenge_text") @db.Text
  approachText     String?   @map("approach_text") @db.Text
  resultText       String?   @map("result_text") @db.Text
  projectType      String?   @map("project_type")
  duration         String?
  surface          String?
  completionDate   String?   @map("completion_date")
  seoTitle         String?   @map("seo_title")
  seoDescription   String?   @map("seo_description")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project          V2Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String    @map("project_id")

  @@unique([projectId, locale])
  @@index([locale])
  @@map("v2_project_translations")
}

model V2ProjectImage {
  id            String    @id @default(cuid())
  imageUrl      String    @map("image_url")
  alt           String?
  caption       String?
  sortOrder     Int       @default(0) @map("sort_order")
  kind          String    @default("gallery")
  createdAt     DateTime  @default(now()) @map("created_at")

  project       V2Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String    @map("project_id")

  @@index([projectId, sortOrder])
  @@map("v2_project_images")
}

model V2Asset {
  id            String    @id @default(cuid())
  filename      String
  originalName  String    @map("original_name")
  mimeType      String    @map("mime_type")
  size          Int
  bucket        String    @default("project-photos")
  path          String
  url           String
  alt           String?
  width         Int?
  height        Int?
  tags          String[]  @default([])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([bucket])
  @@index([createdAt(sort: Desc)])
  @@map("v2_assets")
}

model V2SiteSetting {
  id            String    @id @default(cuid())
  key           String    @unique
  valueJson     Json      @map("value_json")
  category      String    @default("general")
  description   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([category])
  @@map("v2_site_settings")
}

model V2LeadEvent {
  id            String    @id @default(cuid())
  leadType      String    @map("lead_type")
  leadId        String    @map("lead_id")
  eventType     String    @map("event_type")
  payload       Json?     @map("payload")
  createdAt     DateTime  @default(now()) @map("created_at")

  quote         V2QuoteRequest?  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId       String?          @map("quote_id")
  appointment   V2Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String?          @map("appointment_id")

  @@index([leadType, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@map("v2_lead_events")
}

model V2AuditEvent {
  id            String       @id @default(cuid())
  action        String
  entityType    String       @map("entity_type")
  entityId      String       @map("entity_id")
  payload       Json?        @map("payload")
  createdAt     DateTime     @default(now()) @map("created_at")

  actor         V2AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId       String?      @map("actor_id")

  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, createdAt(sort: Desc)])
  @@map("v2_audit_events")
}
